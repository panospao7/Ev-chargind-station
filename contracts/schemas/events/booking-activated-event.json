  "$id": "https://schema-registry.example.com/events/booking-activated-event.json",
  "title": "BookingActivatedEvent",
  "description": "Payload for the BookingActivated event",
  "type": "object",
  "properties": {
    "bookingRef": {
      "type": "string",
      "description": "Booking reference"
