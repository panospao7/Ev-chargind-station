{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-registry.example.com/events/device-fault-raised-event.json",
  "title": "DeviceFaultRaisedEvent",
  "description": "Payload for the DeviceFaultRaised event; contains no device credentials or internal diagnostics",
  "type": "object",
  "properties": {
    "deviceRef": {
      "type": "string",
      "description": "Device reference"
    },
    "evseRef": {
      "type": "string",
      "description": "EVSE reference (present when the device is bound to an EVSE)"
    },
    "faultCode": {
      "type": "string",
      "description": "Normalized fault code"
    },
    "faultDescription": {
      "type": "string",
      "description": "Short normalized fault description"
    },
    "raisedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fault raise timestamp"
    }
  },
  "required": ["deviceRef", "faultCode", "raisedAt"]
}
