{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-registry.example.com/events/evse-configuration-changed-event.json",
  "title": "EVSEConfigurationChangedEvent",
  "description": "EVSE configuration fact (ARC-020 §6). Consumer is discovery-insights-service only.",
  "type": "object",
  "properties": {
    "evseRef": {
      "type": "string",
      "description": "EVSE reference"
    },
    "stationRef": {
      "type": "string",
      "description": "Owning station reference"
    },
    "evseUid": {
      "type": "string",
      "description": "Provider-side EVSE UID"
    }
  },
  "required": [
    "evseRef",
    "stationRef",
    "evseUid"
  ]
}
