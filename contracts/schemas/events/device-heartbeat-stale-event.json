{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-registry.example.com/events/device-heartbeat-stale-event.json",
  "title": "DeviceHeartbeatStaleEvent",
  "description": "Payload for the DeviceHeartbeatStale event",
  "type": "object",
  "properties": {
    "deviceRef": {
      "type": "string",
      "description": "Device reference"
    },
    "evseRef": {
      "type": "string",
      "description": "EVSE reference (present when the device is bound to an EVSE)"
    },
    "lastHeartbeatAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last received heartbeat"
    }
  },
  "required": ["deviceRef", "lastHeartbeatAt"]
}
