{
  "name": "ev-charging-platform-contracts",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "contracts:openapi": "spectral lint --fail-severity=error contracts/openapi/*.yaml",
    "contracts:asyncapi": "asyncapi validate contracts/asyncapi/platform-messaging-v1.yaml",
    "contracts:schemas": "node scripts/contracts/validate-schemas.js",
    "contracts:registries": "node scripts/contracts/check-registries.js",
    "contracts:privacy": "node scripts/contracts/security-scan.js",
    "contracts:docs": "node scripts/contracts/check-docs.js",
    "contracts:secrets": "secretlint --secretlintrc scripts/contracts/secretlintrc.json \"contracts/**/*.{yaml,json}\"",
    "contracts:self-test": "node scripts/contracts/self-test.mjs",
    "contracts:verify": "npm run contracts:openapi && npm run contracts:asyncapi && npm run contracts:schemas && npm run contracts:registries && npm run contracts:privacy && npm run contracts:docs && npm run contracts:secrets && npm run contracts:self-test"
  },
  "devDependencies": {
    "@asyncapi/cli": "2.13.0",
    "@secretlint/secretlint-rule-preset-recommend": "8.5.0",
    "@stoplight/spectral-cli": "6.16.3",
    "ajv": "8.17.1",
    "glob": "10.4.5",
    "js-yaml": "4.1.0",
    "secretlint": "8.5.0"
  },
  "overrides": {
    "@stoplight/spectral-cli": {
      "ajv": "8.17.1"
    }
  }
}
