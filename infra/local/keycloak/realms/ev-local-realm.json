          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "ev-bff-token-exchange-policy",
        "conditions": [
          {
            "condition": "client-attributes",
            "configuration": {
              "attributes": {
                "standard.token.exchange.enabled": "true"
              }
            }
          }
        ],
        "profiles": [
          "ev-token-exchange-downscope"
        ]
      }
    ]
  },
  "clients": [
    {
      "id": "ev-bff",
      "clientId": "ev-bff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-jwt",
      "redirectUris": [
        "http://127.0.0.1:8081/login/oauth2/code/ev-bff"
      ],
      "webOrigins": [
        "http://127.0.0.1:8081"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "use.jwks.string": "true",
        "jwks.string": "<PLACEHOLDER_JWKS_EV_BFF>",
        "pkce.code.challenge.method": "S256",
        "token.endpoint.auth.signing.alg": "RS256",
        "backchannel.logout.url": "http://127.0.0.1:8081/api/internal/back-channel-logout",
