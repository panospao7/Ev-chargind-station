# =============================================================================
# Local development environment placeholders — COPY to .env for overrides.
#
# These are DEVELOPMENT-ONLY defaults, valid on a loopback-only stack. They
# are NOT production credentials and must never be replaced with real ones
# locally (ENG-001 doc §3: production secrets never used locally).
# =============================================================================

POSTGRES_SUPER_USER=evplatform_admin
POSTGRES_SUPER_PASSWORD=evplatform_dev_only
POSTGRES_BOOTSTRAP_DB=evplatform_bootstrap

RABBITMQ_USER=evplatform_dev
RABBITMQ_PASSWORD=evplatform_dev_only

KEYCLOAK_ADMIN=evplatform_admin
KEYCLOAK_ADMIN_PASSWORD=evplatform_dev_only

# Password applied to every provisioned owner/migrator/runtime role (all 27
# roles share this one dev-only value; see infra/local/postgres/01-provision.sh).
PLATFORM_ROLE_PASSWORD=evplatform_dev_only
