      ".env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/secrets/**": "deny"
    },
    "task": "allow",
    "skill": "ask",
    "webfetch": "ask",
    "websearch": "ask",
